# ---- LLM (OpenAI-compatible). Pick ONE block. ----

# OpenAI
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=gpt-4o-mini
ROUTER_MODEL=gpt-4o-mini

# Groq (free tier, fast)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk-replace-me
# LLM_MODEL=qwen/qwen3.8-27b
# ROUTER_MODEL=qwen/qwen3.8-27b
# Avoid reasoning models (e.g. openai/gpt-oss-*) as ROUTER_MODEL: the router allows
# 8 output tokens, which reasoning uses up, so every reply comes back empty.

# Local Ollama (no key needed)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# ---- Vector store ----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=physics_doubts

# ---- Retrieval tuning ----
CANDIDATES_K=20
FINAL_K=4
SEMANTIC_CACHE_ENABLED=1
SEMANTIC_CACHE_THRESHOLD=0.93
SEMANTIC_CACHE_TTL=3600

# ---- API protection ----
# Required: the API won't start with this empty. The UI sends it automatically.
# This example key is public, so the API won't start with it. Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# To run with no key (local use only), empty it and set ALLOW_UNAUTHENTICATED=1.
API_KEY=i7R48FI6S1tD5DUcVQOxTcebStkrO-FMjkd9qzR5VYU
# ALLOW_UNAUTHENTICATED=1
CORS_ORIGINS=http://localhost:8501
RATE_LIMIT_PER_MIN=60
# Behind a reverse proxy, every request looks like the proxy and shares one rate
# limit. Set this to the proxy's IP so limits apply per client. Never use * unless
# only the proxy can reach the API, or clients can fake their IP.
# FORWARDED_ALLOW_IPS=10.0.0.1
